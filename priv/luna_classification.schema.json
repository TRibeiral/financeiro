{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer" },
          "category": {
            "type": "string",
            "enum": [
              "Casa",
              "Funcionarios",
              "Mercado",
              "Restaurante",
              "Transporte",
              "Saude",
              "Extras",
              "Filho",
              "Viagem",
              "Pet",
              "Projetos",
              "Outros"
            ]
          },
          "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "required": ["id", "category", "confidence"]
      }
    }
  },
  "required": ["classifications"]
}
